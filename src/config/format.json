{
  "post": {
    "title": "{{ title }}",
    "titleWithRecipient": "{{ title }} （To: {{ recipient }}）",
    "authorInfo": "{{ authorName }}＠{{ group }} ( {{ createdAt }} )",
    "authorInfoWithoutGroup": "{{ authorName }} ( {{ createdAt }} )",
    "content": "{{ content }}"
  },
  "thread": {
    "listFormat": "【{{ authorName }}＠{{ group }}】{{ title }}  {{ createdAt }}"
  },
  "hierarchyTree": {
    "threadPrefix": "■",
    "postPrefix": "　┣",
    "postLastPrefix": "　┗",
    "postContinuePrefix": "　┃",
    "postIndent": "　"
  },
  "date": {
    "format": "yyyy/MM/dd HH:mm"
  }
}